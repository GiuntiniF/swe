<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" xmlns:general="https://gaphor.org/modelinglanguage/general" version="4" gaphor-version="3.3.2">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {
  text-color:#000!important;
  background-color: #fff;
  color: #000!important;
  line-width: 2;
}
diagram * {
    color: #000!important;
}
package {
  background-color: #eee;
}
package &gt; name {
  font-size: 40px;
}
interface, class, 
enumeration, datatype {
  background-color: #fff;
}
ellipse, line {
  dash-style: 10;
  color: #999;
}
ellipse {
  background-color: #fff;
}
line {
  color: #999;
  text-color:#000;
}

executionspecification {
  background-color: #fff;
}
comment[annotatedElement=interaction] {
  color: transparent;
  background-color: transparent;
  text-color: black;
}
line[label*="else"] {
  dash-style: 7 5;
  color: #000;
}
line[label*="else"] label {
  padding: -22 0 0 0;
}
line[label*="conflict presente"] {
  dash-style: 7 5;
  color: #000;
}
line[label*="conflict presente"] label {
  padding: -22 0 0 0;
 }

interaction:not([name="alt"]):not([name="loop"]):not([name="opt"]) {
  background-color: #fff;
}
</val>
</styleSheet>
</Core:StyleSheet>
