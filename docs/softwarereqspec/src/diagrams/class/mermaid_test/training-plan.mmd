---
title: TrainingPlan
---
classDiagram
    class TrainingPlan {
        -string name
        -string description
        -/int numberOfMonths
        -/boolean isFrozen
    }

    class MonthlyBlock {
        -int order
        -int weeksCount = 4
    }

    class TrainingSession {
        +getTotalCalories() int
        +getTotalVolume() int
        +getTotalLoad() float
    }

    class PlanAssignment {
        -LocalDate startDate
        -/LocalDate endDate
        -/AssignmentStatus status
        +getWeek(n: int) WeeklyPrescription[*]
        +canMoveTo(newStart: LocalDate) Boolean
        +moveTo(newStart: LocalDate)
    }

    class AssignmentStatus {
        <<enumeration>>
        NonIniziata
        InCorso
        Terminata
    }

    class ExerciseLoad {
        -Weight weight
    }

    class SessionOverride {
        -int weekNumber
        -TrainingSession session
        -Exercise exercise
        -Weight[0..1] weight
        -Reps[0..1] reps
        -int[0..1] sets
        -Duration[0..1] restTime
        -bool skipped
        -Exercise[0..1] replacedBy
    }

    class TrainingSessionLog {
        -LocalDate date
        -/int weekNumber
        -TrainingSession session
    }

    class ActivityLog {
        <<abstract>>
        -WorkoutActivity activity
        -bool skipped
    }

    class ExerciseLog {
        -int[0..1] actualSets
        -int[0..1] actualReps
        -Weight[0..1] actualWeight
    }

    class CardioLog {
        -float[0..1] actualTargetValue
    }

    TrainingPlan "1" *-- "1..*" MonthlyBlock : blocks
    MonthlyBlock "1" *-- "0..7" TrainingSession : sessions
    TrainingSession "1" *-- "1..*" WorkoutActivity : exercises
    TrainingPlan "1" -- "0..*" PlanAssignment : plan / assignments
    Athlete "1" -- "0..*" PlanAssignment : athlete / assignments
    PT "1" -- "0..*" TrainingPlan : author

    PlanAssignment "1" *-- "0..*" ExerciseLoad : assignment
    ExerciseLoad "0..*" -- "1" Exercise
    PlanAssignment "1" *-- "0..*" SessionOverride : assignment
    PlanAssignment "1" *-- "0..*" TrainingSessionLog : assignment
    TrainingSessionLog "1" *-- "1..*" ActivityLog

    ExerciseLog --|> ActivityLog
    CardioLog --|> ActivityLog

    PlanAssignment ..> AssignmentStatus

%% ---------------------------------------------------------------------------
%% Derivazioni degli attributi (nel .puml stavano inline, qui non esprimibili
%% nel corpo della classe)
%%
%% TrainingPlan
%%   /numberOfMonths = blocks->size()
%% MonthlyBlock
%%   weeksCount = 4 {costante}
%% PlanAssignment
%%   /endDate = startDate + 28 * plan.numberOfMonths - 1
%% TrainingSessionLog
%%   /weekNumber = (date - assignment.startDate).giorni div 7 + 1
%%
%% ---------------------------------------------------------------------------
%% Vincoli (#36 passata 6) — cfr. nota in user.mmd: stanno qui come commenti
%% perché ADR-0001 §6 e #43 escludono le `note` dai sorgenti dei diagrammi; la
%% forma discorsiva va in CONTEXT.md (#43).
%%
%% Su TrainingPlan
%%   {isFrozen}
%%     /isFrozen = assignments->exists(a | a./status <> AssignmentStatus::Terminata)
%%   {congelamento} (#5 §4)
%%     isFrozen implies il contenuto della scheda — blocks, sessions, activities,
%%     progressions, loadPrescription — è in sola lettura.
%%   {ptCoerente} (#2)
%%     assignments->forAll(a | a.athlete.pt = self.author)
%%     Ogni atleta assegnato ha come PT l'autore della scheda.
%%
%% Su PlanAssignment
%%   {status} (#25)
%%     /status = today < startDate
%%                 ? AssignmentStatus::NonIniziata
%%                 : (today <= /endDate ? AssignmentStatus::InCorso
%%                                      : AssignmentStatus::Terminata)
%%   {moveTo} (#25)
%%     pre:  startDate > today and canMoveTo(newStart)
%%     post: startDate = newStart
%%   {canMoveTo} (#25)
%%     canMoveTo(newStart) quantifica su athlete.assignments->excluding(self)
%%     e verifica solo la sovrapposizione.
%%   {caricoPerEsercizio} (#16)
%%     Un ExerciseLoad per ogni Exercise prescritto nella scheda, zero se la
%%     prescrizione è BodyweightLoad.
%%
%% Su TrainingSessionLog
%%   {unicità} (#14 §9.1)
%%     Unico per (assignment, session, /weekNumber).
%%   {finestra} (#14 §9.2)
%%     assignment.startDate <= date <= assignment./endDate and date <= today
%%   {sessioneNelBlocco} (#14 §9.3)
%%     session appartiene al MonthlyBlock che contiene /weekNumber.
%%   {copertura} (#14 §9.4)
%%     Un ActivityLog per ogni attività prescritta nella sessione che possiede
%%     parametri propri: Superset e HIIT espansi, decoratori trasparenti.
%%
%% Su ActivityLog e sottotipi
%%   {skipped}
%%     skipped implies tutti i valori svolti vuoti.
%%   {ExerciseLog completo}
%%     not skipped implies actualSets->notEmpty() and actualReps->notEmpty()
%%     actualWeight resta opzionale, per il corpo libero.
%%   {CardioLog completo} (#14 §9.5)
%%     not skipped implies actualTargetValue->notEmpty()
%% ---------------------------------------------------------------------------
