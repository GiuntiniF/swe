---
title: User
---
classDiagram
    class User {
        -string firstName
        -string lastName
        -string email
    }

    class Athlete {
        -LocalDate birthDate
        -float height
        -float weight
        +getAge() int
        +isFreeIn(s: LocalDate, e: LocalDate) Boolean
    }

    class PT

    class OneRepMax {
        -ExerciseType exerciseType
        -float value
        -WeightMeasureUnit unit
        -LocalDate measuredOn
    }

    Athlete --|> User
    PT --|> User

    PT "1" -- "0..*" Athlete : pt / athletes
    Athlete "1" -- "0..*" OneRepMax : oneRepMaxes
    Athlete "0..*" -- "0..*" Gym : gymList

